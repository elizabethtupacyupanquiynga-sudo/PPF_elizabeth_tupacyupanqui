---
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
	title: string;
	description: string;
}

const { lang, title, description } = Astro.props;

// URLs relativas generadas con la utilidad oficial de Astro i18n.
// Cuando se configure `site` en astro.config.mjs, cambiar a
// `getAbsoluteLocaleUrl("es")` / `getAbsoluteLocaleUrl("en")`
// para emitir hreflang absolutos.
const esUrl = getRelativeLocaleUrl("es");
const enUrl = getRelativeLocaleUrl("en");
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={esUrl} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
