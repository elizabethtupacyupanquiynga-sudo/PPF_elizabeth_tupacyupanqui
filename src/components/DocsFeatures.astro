---
import { getRelativeLocaleUrl } from "astro:i18n";
import { ui } from "../i18n/ui";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cards = ui[lang].sections.docsFeatures.cards;

const slugs = ["getting-started", "styling-your-theme", "premium-features"];
const shapes = [
	"rounded-full bg-lime-200 ring-1 ring-teal-800/15",
	"rounded-xl bg-teal-700",
	"rotate-45 rounded-[0.4rem] bg-teal-700/10 ring-1 ring-teal-700/25",
];
---

<section aria-labelledby="docs-features-title" class="bg-white">
	<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
		<div class="max-w-2xl">
			<h2
				id="docs-features-title"
				class="text-[1.7rem] font-black leading-[1.12] tracking-tight text-balance text-neutral-950 sm:text-4xl sm:leading-[1.1]"
			>
				{t("sections.docsFeatures.title")}
			</h2>
		</div>
		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{cards.map((card, index) => (
				<article
					aria-labelledby={`docs-card-${index}-title`}
					class="rounded-2xl border border-neutral-200 bg-white p-7 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-neutral-950/5"
				>
					<span
						aria-hidden="true"
						class={`block h-10 w-10 ${shapes[index % shapes.length]}`}
					></span>
					<h3
						id={`docs-card-${index}-title`}
						class="mt-5 text-lg font-bold tracking-tight text-neutral-950"
					>
						{card.title}
					</h3>
					<p class="mt-2 text-sm leading-relaxed text-neutral-600">
						{card.description}
					</p>
					<a
						href={getRelativeLocaleUrl(lang, `news/${slugs[index]}`)}
						class="mt-4 inline-block py-1 text-sm font-semibold text-teal-700 underline-offset-4 hover:underline"
					>
						{card.linkText}<span aria-hidden="true"> →</span><span class="sr-only">: {card.title}</span>
					</a>
				</article>
			))}
		</div>
	</div>
</section>
