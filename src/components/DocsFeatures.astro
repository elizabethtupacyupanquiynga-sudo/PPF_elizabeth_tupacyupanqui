---
import { getRelativeLocaleUrl } from "astro:i18n";
import { ui } from "../i18n/ui";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cards = ui[lang].sections.docsFeatures.cards;

const slugs = ["getting-started", "styling-your-theme", "premium-features"];
const shapes = [
	"rounded-full bg-amber-100 ring-1 ring-amber-700/20",
	"rounded-lg bg-neutral-900",
	"rotate-45 rounded-[0.35rem] bg-amber-700/15 ring-1 ring-amber-700/25",
];
---

<section aria-labelledby="docs-features-title">
	<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-20">
		<h2
			id="docs-features-title"
			class="font-serif text-3xl font-bold leading-tight text-neutral-950 sm:text-4xl"
		>
			{t("sections.docsFeatures.title")}
		</h2>
		<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{cards.map((card, index) => (
				<article
					aria-labelledby={`docs-card-${index}-title`}
					class="rounded-xl border border-neutral-200 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-neutral-300 hover:shadow-md"
				>
					<span
						aria-hidden="true"
						class={`block h-10 w-10 ${shapes[index % shapes.length]}`}
					></span>
					<h3
						id={`docs-card-${index}-title`}
						class="mt-4 text-lg font-semibold text-neutral-950"
					>
						{card.title}
					</h3>
					<p class="mt-2 text-sm leading-relaxed text-neutral-600">
						{card.description}
					</p>
					<a
						href={getRelativeLocaleUrl(lang, `news/${slugs[index]}`)}
						class="mt-4 inline-block text-sm font-semibold text-amber-700 underline-offset-4 hover:underline"
					>
						{card.linkText} →
					</a>
				</article>
			))}
		</div>
	</div>
</section>
