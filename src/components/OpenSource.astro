---
import ImagePlaceholder from "./ImagePlaceholder.astro";
import { ui } from "../i18n/ui";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = ui[lang].sections.openSource.items;
---

<section aria-labelledby="open-source-title" class="bg-white">
	<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
		<div
			class="grid items-center gap-10 overflow-hidden rounded-2xl bg-teal-950 px-6 py-10 shadow-xl shadow-teal-950/10 sm:px-10 lg:grid-cols-2 lg:gap-16 lg:px-16 lg:py-16"
		>
			<div class="overflow-hidden rounded-2xl ring-1 ring-white/15">
				<ImagePlaceholder
					label={t("sections.openSource.imageLabel")}
					variant="video"
					rounded={false}
				/>
			</div>
			<div>
				<h2
					id="open-source-title"
					class="text-[1.7rem] font-black leading-[1.12] tracking-tight text-balance text-white sm:text-4xl sm:leading-[1.1]"
				>
					{t("sections.openSource.title")}
				</h2>
				<p class="mt-4 leading-relaxed text-teal-50/80">
					{t("sections.openSource.description")}
				</p>
				<ul class="mt-6 space-y-3">
					{items.map((item) => (
						<li class="flex items-start gap-3 text-teal-50">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								class="mt-0.5 shrink-0 text-lime-300"
							>
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
							<span>{item}</span>
						</li>
					))}
				</ul>
				<a
					href="#"
					class="mt-8 inline-block rounded-full bg-lime-300 px-7 py-3 text-sm font-semibold text-teal-950 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-lime-200 hover:shadow-md"
				>
					{t("buttons.github")}
				</a>
				<article
					aria-labelledby="attribution-title"
					class="mt-8 border-t border-white/10 pt-6"
				>
					<h3 id="attribution-title" class="text-sm font-semibold text-white">
						{t("sections.openSource.attributionTitle")}
					</h3>
					<p class="mt-2 text-sm leading-relaxed text-teal-50/70">
						{t("sections.openSource.attributionText")}{" "}
						<a
							href="https://shop.unfolding.io/b/qN8Ku"
							class="font-semibold text-lime-300 underline-offset-4 hover:underline"
						>
							{t("buttons.removeAttribution")}
						</a>
					</p>
				</article>
			</div>
		</div>
	</div>
</section>
