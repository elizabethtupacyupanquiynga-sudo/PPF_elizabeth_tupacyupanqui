---
import ImagePlaceholder from "./ImagePlaceholder.astro";
import { ui } from "../i18n/ui";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = ui[lang].sections.openSource.items;
---

<section aria-labelledby="open-source-title">
	<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-20">
		<div
			class="grid items-center gap-8 overflow-hidden rounded-2xl bg-neutral-950 px-6 py-10 sm:px-10 lg:grid-cols-2 lg:gap-12 lg:px-16 lg:py-16"
		>
			<div>
				<ImagePlaceholder
					label={t("sections.openSource.imageLabel")}
					variant="video"
					rounded={false}
				/>
			</div>
			<div>
				<h2
					id="open-source-title"
					class="font-serif text-3xl font-bold leading-tight text-white sm:text-4xl"
				>
					{t("sections.openSource.title")}
				</h2>
				<p class="mt-4 leading-relaxed text-neutral-300">
					{t("sections.openSource.description")}
				</p>
				<ul class="mt-6 space-y-3">
					{items.map((item) => (
						<li class="flex items-start gap-3 text-neutral-200">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								class="mt-0.5 shrink-0 text-amber-500"
							>
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
							<span>{item}</span>
						</li>
					))}
				</ul>
				<a
					href="#"
					class="mt-8 inline-block rounded-full bg-amber-600 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-amber-500"
				>
					{t("buttons.github")}
				</a>
				<article
					aria-labelledby="attribution-title"
					class="mt-8 border-t border-white/10 pt-6"
				>
					<h3 id="attribution-title" class="text-sm font-semibold text-white">
						{t("sections.openSource.attributionTitle")}
					</h3>
					<p class="mt-2 text-sm leading-relaxed text-neutral-400">
						{t("sections.openSource.attributionText")}{" "}
						<a
							href="https://shop.unfolding.io/b/qN8Ku"
							class="font-semibold text-amber-500 underline-offset-4 hover:underline"
						>
							{t("buttons.removeAttribution")}
						</a>
					</p>
				</article>
			</div>
		</div>
	</div>
</section>
