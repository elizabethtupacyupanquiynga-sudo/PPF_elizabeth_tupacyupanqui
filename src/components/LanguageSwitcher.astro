---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const esUrl = getRelativeLocaleUrl("es");
const enUrl = getRelativeLocaleUrl("en");

const baseLink = "rounded px-1.5 py-1 text-xs tracking-widest uppercase";
const activeLink = "font-semibold text-neutral-900 underline underline-offset-4";
const inactiveLink = "text-neutral-500 hover:text-neutral-900";
---

<nav aria-label={t("langSelector.label")} class="flex items-center gap-1">
	<a
		href={esUrl}
		aria-label={t("langSelector.es")}
		aria-current={lang === "es" ? "page" : undefined}
		class={`${baseLink} ${lang === "es" ? activeLink : inactiveLink}`}
	>
		ES
	</a>
	<span aria-hidden="true" class="text-xs text-neutral-300">/</span>
	<a
		href={enUrl}
		aria-label={t("langSelector.en")}
		aria-current={lang === "en" ? "page" : undefined}
		class={`${baseLink} ${lang === "en" ? activeLink : inactiveLink}`}
	>
		EN
	</a>
</nav>
