---
interface Props {
	label: string;
	variant?: "video" | "vertical";
	rounded?: boolean;
}

const { label, variant = "video", rounded = true } = Astro.props;

const aspectClass = variant === "vertical" ? "aspect-[4/5]" : "aspect-video";
const roundedClass = rounded ? "rounded-2xl" : "rounded-none";
---

<div
	role="img"
	aria-label={label}
	class={`flex w-full min-w-0 ${aspectClass} ${roundedClass} flex-col items-center justify-center gap-1 overflow-hidden border-2 border-dashed border-neutral-300 bg-neutral-100 p-4 text-center sm:p-6`}
>
	<span class="text-xs font-bold tracking-[0.18em] text-neutral-600">IMAGE PLACEHOLDER</span>
	<span class="min-w-0 break-words text-[0.8rem] font-medium leading-snug text-neutral-700 sm:text-sm">{label}</span>
</div>
