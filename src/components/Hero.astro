---
import ImagePlaceholder from "./ImagePlaceholder.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const aboutUrl = getRelativeLocaleUrl(lang, "about-astrorante");
const menuUrl = getRelativeLocaleUrl(lang, "menu");

// Destaca las dos últimas palabras del título sin hardcodear texto,
// funciona para ambos idiomas.
const titleWords = t("hero.title").split(" ");
const titleStart = titleWords.slice(0, -2).join(" ");
const titleHighlight = titleWords.slice(-2).join(" ");
---

<section aria-labelledby="hero-title" class="bg-lime-50">
	<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-24">
		<div class="mx-auto max-w-3xl text-center">
			<p class="inline-flex max-w-full items-center rounded-full bg-lime-200/70 px-3 py-1.5 text-center text-[0.7rem] font-bold uppercase leading-relaxed tracking-[0.12em] text-teal-900 ring-1 ring-teal-800/10 sm:px-4 sm:text-xs sm:tracking-[0.18em]">
				{t("hero.eyebrow")}
			</p>
			<h1
				id="hero-title"
				class="mt-6 text-[2rem] font-black leading-[1.08] tracking-tight text-balance text-neutral-950 sm:text-5xl sm:leading-[1.05] lg:text-6xl"
			>
				{titleStart}{" "}
				<span class="text-teal-700 underline decoration-lime-300 decoration-[0.18em] underline-offset-[0.2em]">{titleHighlight}</span>
			</h1>
			<p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-neutral-600 sm:text-lg">
				{t("hero.description")}
			</p>
			<div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
				<a
					href={aboutUrl}
					class="w-full rounded-full bg-teal-700 px-7 py-3 text-center text-sm font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-teal-800 hover:shadow-md sm:w-auto"
				>
					{t("hero.ctaPrimary")}
				</a>
				<a
					href={menuUrl}
					class="w-full rounded-full border border-teal-800/20 bg-white px-7 py-3 text-center text-sm font-semibold text-teal-900 transition-all hover:-translate-y-0.5 hover:border-teal-700 hover:shadow-md sm:w-auto"
				>
					{t("hero.ctaSecondary")}
				</a>
			</div>
		</div>
		<div class="mx-auto mt-12 max-w-5xl lg:mt-16">
			<div class="overflow-hidden rounded-2xl shadow-xl shadow-teal-950/10 ring-1 ring-neutral-950/10">
				<ImagePlaceholder label={t("hero.imageLabel")} variant="video" rounded={false} />
			</div>
		</div>
	</div>
</section>
