---
import ImagePlaceholder from "./ImagePlaceholder.astro";
---

<section aria-labelledby="tasty-deals-title">
	<h2 id="tasty-deals-title">Tasty deals</h2>
	<p>You can show your happy hour deals here</p>

	<article aria-labelledby="deal-tapas-title">
		<ImagePlaceholder label="Tapas For Two Dish" variant="vertical" />
		<h3 id="deal-tapas-title">Tapas For Two</h3>
		<p>25% of tapas for two, every Sunday</p>
		<span>$750</span>
	</article>

	<article aria-labelledby="deal-mojito-title">
		<ImagePlaceholder label="Mojito Monday Drink" variant="vertical" />
		<h3 id="deal-mojito-title">Mojito Monday</h3>
		<p>Every Monday from 5am to 7am</p>
		<span>$400</span>
	</article>

	<article aria-labelledby="deal-margarita-title">
		<ImagePlaceholder label="Classic Margarita Drink" variant="vertical" />
		<h3 id="deal-margarita-title">Margarita Thursday</h3>
		<p>Every Thursday from 5am to 7am</p>
		<span>$350</span>
	</article>
</section>
