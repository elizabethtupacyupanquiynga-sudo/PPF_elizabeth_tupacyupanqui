---
import ImagePlaceholder from "./ImagePlaceholder.astro";

export type FeatureImagePosition = "left" | "right";
export type FeatureImageVariant = "video" | "vertical";

interface Props {
	eyebrow?: string;
	title: string;
	description?: string | string[];
	features?: string[];
	ctaText?: string;
	href?: string;
	imagePosition?: FeatureImagePosition;
	imageLabel: string;
	imageVariant?: FeatureImageVariant;
	headingId: string;
	tone?: "white" | "cream";
}

const {
	eyebrow,
	title,
	description,
	features,
	ctaText,
	href,
	imagePosition = "right",
	imageLabel,
	imageVariant = "video",
	headingId,
	tone = "white",
} = Astro.props;

const paragraphs = Array.isArray(description)
	? description
	: description
		? [description]
		: [];

const sectionTone = tone === "cream" ? "bg-lime-50/60" : "bg-white";

const imageOrder = imagePosition === "left" ? "lg:order-1" : "lg:order-2";
const contentOrder = imagePosition === "left" ? "lg:order-2" : "lg:order-1";
---

<section aria-labelledby={headingId} class={sectionTone}>
	<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
		<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
			<div class={imageOrder}>
				<div class="overflow-hidden rounded-2xl shadow-lg shadow-neutral-950/5 ring-1 ring-neutral-950/10">
					<ImagePlaceholder label={imageLabel} variant={imageVariant} rounded={false} />
				</div>
			</div>
			<div class={contentOrder}>
				{eyebrow && (
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-teal-700">
						{eyebrow}
					</p>
				)}
				<h2
					id={headingId}
					class="mt-3 text-[1.7rem] font-black leading-[1.12] tracking-tight text-balance text-neutral-950 sm:text-4xl sm:leading-[1.1]"
				>
					{title}
				</h2>
				{paragraphs.map((paragraph) => (
					<p class="mt-4 leading-relaxed text-neutral-600">{paragraph}</p>
				))}
				{features && features.length > 0 && (
					<ul class="mt-6 space-y-3">
						{features.map((feature) => (
							<li class="flex items-start gap-3 leading-relaxed text-neutral-700">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									class="mt-0.5 shrink-0 text-teal-600"
								>
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>{feature}</span>
							</li>
						))}
					</ul>
				)}
				{ctaText && href && (
					<a
						href={href}
						class="mt-8 inline-block rounded-full border border-teal-800/20 bg-white px-7 py-3 text-sm font-semibold text-teal-900 shadow-sm transition-all hover:-translate-y-0.5 hover:border-teal-700 hover:shadow-md"
					>
						{ctaText}
					</a>
				)}
			</div>
		</div>
	</div>
</section>
