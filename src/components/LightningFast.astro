---
import FeatureSection from "./FeatureSection.astro";
import { ui } from "../i18n/ui";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<FeatureSection
	title={t("sections.lightningFast.title")}
	description={t("sections.lightningFast.description")}
	features={ui[lang].sections.lightningFast.items}
	imagePosition="right"
	imageLabel={t("sections.lightningFast.imageLabel")}
	imageVariant="video"
	headingId="lightning-fast-title"
/>
